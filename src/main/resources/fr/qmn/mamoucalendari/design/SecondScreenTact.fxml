<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080.0" prefWidth="1920.0"
            xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:id="ocrFxml" fx:controller="fr.qmn.mamoucalendari.controller.tact.OCRController">
   <children>
      <!-- Colonne gauche : sélecteur heures + minutes -->
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#ffd9d8" height="540.0" stroke="#ff9d9d" strokeType="INSIDE" strokeWidth="4.0" width="215.0" />
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#ffd9d8" height="540.0" layoutY="540.0" stroke="#ff9d9d" strokeType="INSIDE" strokeWidth="4.0" width="215.0" />
      <ListView fx:id="ListHours" layoutX="8.0" layoutY="7.0" prefHeight="525.0" prefWidth="200.0" onMouseDragged="#onListViewDragged" onMouseReleased="#onListViewReleased" onMousePressed="#onListViewClicked" />
      <ListView fx:id="ListMinutes" layoutX="8.0" layoutY="548.0" prefHeight="525.0" prefWidth="200.0" onMouseDragged="#onListMinutesDragged" onMousePressed="#onListinutesClicked" onMouseReleased="#onListMinutesViewReleased"/>

      <!-- Bandeau supérieur : date + boutons jour -->
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#ffd9d8" height="215.0" layoutX="215.0" stroke="#ff9d9d" strokeType="INSIDE" strokeWidth="4.0" width="1705.0" />
      <Text fx:id="textActualDay" layoutX="949.0" layoutY="112.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Text" />
      <Button fx:id="buttonPrevDay" layoutX="276.0" layoutY="59.0" mnemonicParsing="false" prefHeight="99.0" prefWidth="332.0" text="Button" />
      <Button fx:id="buttonNextDay" layoutX="1535.0" layoutY="59.0" mnemonicParsing="false" prefHeight="99.0" prefWidth="332.0" text="Button"/>

      <!-- Zone principale : canvas plein écran avec clavier en overlay (caché par défaut) -->
      <AnchorPane fx:id="canvasPane" layoutX="217.0" layoutY="213.0" prefWidth="1704.0" prefHeight="752.0" visible="false">
         <children>
            <!-- Canvas plein écran -->
            <Canvas fx:id="drawingCanvas" width="1704.0" height="752.0" />
            <!-- Clavier AZERTY (caché par défaut) -->
            <AnchorPane fx:id="keyboardPane" prefWidth="1704.0" prefHeight="752.0" visible="false" />
            <!-- Bouton gomme -->
            <Button fx:id="buttonGomme" text="🧹 Gomme" mnemonicParsing="false"
                    style="-fx-font-size: 22px; -fx-background-color: #f0f0f0; -fx-border-color: #ccc; -fx-border-width: 2; -fx-padding: 12 20; -fx-background-radius: 8;"
                    prefWidth="160.0" prefHeight="60.0"
                    AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0" />
         </children>
      </AnchorPane>

      <!-- Barre du bas -->
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#ffd9d8" height="115.0" layoutX="215.0" layoutY="965.0" stroke="#ff9d9d" strokeType="INSIDE" strokeWidth="4.0" width="1705.0" />
      <Line endX="41.5" endY="61.0" layoutX="1026.0" layoutY="1019.0" startX="41.5" startY="-54.0" stroke="#ff9d9d" strokeWidth="4.0" />
      <Button fx:id="buttonCancel" layoutX="220.0" layoutY="968.0" mnemonicParsing="false" prefHeight="108.0" prefWidth="844.0" text="Annuler" />
      <Button fx:id="buttonCheck" layoutX="1070.0" layoutY="968.0" mnemonicParsing="false" prefHeight="108.0" prefWidth="844.0" text="Valider" />
   </children>
</AnchorPane>
