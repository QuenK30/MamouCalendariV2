<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.qmn.mamoucalendari.controller.login.LoginController">
    <children>
        <VBox fx:id="root" spacing="36.0" alignment="CENTER"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <Label text="MamouCalendari"
                       style="-fx-font-size: 64px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <Label text="Connexion"
                       style="-fx-font-size: 30px; -fx-text-fill: #777;" />
                <TextField fx:id="emailField"
                           promptText="Adresse e-mail" />
                <PasswordField fx:id="passwordField"
                               promptText="Mot de passe" />
                <Button fx:id="loginButton" text="Se connecter"
                        mnemonicParsing="false"
                        onAction="#onLogin" />
                <Label fx:id="errorLabel" text="Identifiants incorrects"
                       visible="false"
                       style="-fx-font-size: 24px; -fx-text-fill: #cc0000;" />
            </children>
        </VBox>
    </children>
</AnchorPane>
